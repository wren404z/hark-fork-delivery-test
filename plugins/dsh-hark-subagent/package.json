{
  "name": "dsh-hark-subagent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "hark 云端 agent 的 DSH 工具面 + 会话头部看板面板",
  "files": [
    "index.js",
    "client.js",
    "board-client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./board-client.js",
    "./package.json": "./package.json"
  }
}
